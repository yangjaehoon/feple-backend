<?xml version="1.0" encoding="UTF-8"?>
<!--
  EI_EXPOSE_REP/EI_EXPOSE_REP2("내부 표현 노출")는 getter가 컬렉션/배열/가변 객체를 그대로
  반환하기만 해도 걸려서, JPA 엔티티·Lombok @Getter·DTO가 많은 이 프로젝트에서는 전체 113건 중
  106건(93%)이 이 두 규칙 하나 때문에 나옴 — 실제 방어적 복사가 필요한 보안 경계라기보다는
  내부 서비스/DTO 계층에서는 노이즈에 가까워 제외한다. 나머지 카테고리(정확성/보안/성능 등)는
  그대로 유지.
-->
<FindBugsFilter>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- CreateCommentDto.parentId: setter/빌더 없이 Jackson이 리플렉션으로 private 필드에 직접
         쓰는 패턴(프로젝트 관례) — 바이트코드 분석으로는 이 대입이 안 보여서 오탐 발생.
         실제로는 createComment()에서 dto.getParentId()로 정상 사용됨. -->
    <Match>
        <Class name="com.feple.feple_backend.comment.dto.CreateCommentDto"/>
        <Field name="parentId"/>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!-- UserPointLog.refId: 포인트 지급 사유(게시글/댓글 등)를 추적하기 위한 감사용 컬럼으로
         의도적으로 쓰기 전용 — 지금 시점에 앱 코드가 다시 읽지 않는다고 getter를 추가하는 건
         YAGNI. DB에는 정상적으로 저장되어 필요시 직접 조회 가능. -->
    <Match>
        <Class name="com.feple.feple_backend.user.entity.UserPointLog"/>
        <Field name="refId"/>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>

    <!-- V16 마이그레이션: 이미 프로덕션에 적용된 Flyway 마이그레이션이라 절대 수정 불가 —
         수정하면 체크섬이 바뀌어 다음 배포에서 Flyway 검증이 깨진다. addIndexIfNotExists는
         이 파일 안에서 항상 하드코딩된 리터럴로만 호출되어 실질적 인젝션 위험은 없음. -->
    <Match>
        <Class name="db.migration.V16__add_festival_performance_indexes"/>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
    </Match>
</FindBugsFilter>
